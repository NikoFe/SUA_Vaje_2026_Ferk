<!DOCTYPE html>
<html>
  <head>
    <link rel="stylesheet" href="/styles.css" />

    <title>SUA Project</title>
  </head>
  <body>
    <ul class="navbar">
      <li><a href="http://localhost:3010/">Home</a></li>
      <li><a href="http://localhost:3010/profile">Profile</a></li>
      <li><a href="http://localhost:3010/store">Store</a></li>
      <li><a href="http://localhost:3010/payment">Payment</a></li>
    </ul>

    <h1>CREATION</h1>

    <form id="create-product-form" onsubmit="createProduct(event)">


      <label for="name">Name:</label><br>
      <input type="text" id="name" name="name" maxlength="45" required><br><br>

      <label for="description">Description:</label><br>
      <textarea id="description" name="description" maxlength="200"></textarea><br><br>

      <label for="cost">Cost:</label><br>
      <input type="number" id="cost" name="cost" min="0" max="999.99" step="0.01" required><br><br>

      <label for="kilograms">Kilograms:</label><br>
      <input type="number" id="kilograms" name="kilograms" min="0" max="99.99" step="0.01" required><br><br>

      <label for="allergens">Allergens:</label><br>
      <textarea id="allergens" name="allergens" maxlength="200"></textarea><br><br>

      <label for="kilojoules">Kilojoules:</label><br>
      <input type="number" id="kilojoules" name="kilojoules" step="1" required><br><br>

      <label for="vitamins">Vitamins:</label><br>
      <textarea id="vitamins" name="vitamins" maxlength="200"></textarea><br><br>

      <label for="stock">Stock:</label><br>
      <input type="number" id="stock" name="stock" step="1" required><br><br>

      <label for="discount">Discount:</label><br>
      <input type="number" id="discount" name="discount" step="1" required><br><br>

      <label for="image_path">Image path:</label><br>
      <input type="text" id="image_path" name="image_path" maxlength="200" placeholder="/images/chickpeas.png"><br><br>

      <button type="submit">Create product</button>
    </form>

    <p id="create-product-status" role="status"></p>



    <div id="products-list" class></div>



    <script src="/image_path.js"></script>
    <script>


    async function createProduct(event) {
      event.preventDefault();

      const status = document.getElementById("create-product-status");
      status.textContent = "Creating product...";

      try {
        const response = await fetch("/store/products", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({

            name: document.getElementById("name").value,
            description: document.getElementById("description").value,
            cost: Number(document.getElementById("cost").value),
            kilograms: Number(document.getElementById("kilograms").value),
            allergens: document.getElementById("allergens").value,
            kilojoules: Number(document.getElementById("kilojoules").value),
            vitamins: document.getElementById("vitamins").value,
            stock: Number(document.getElementById("stock").value),
            discount: Number(document.getElementById("discount").value),
            image_path: getProductImageUrl(document.getElementById("image_path").value)
          })
        });

        if (!response.ok) {
          const result = await response.json().catch(() => ({}));
          throw new Error(result.error || "Failed to create product.");
        }

        window.location.href = "http://localhost:3010/store";
      } catch (error) {
        console.error("Error creating product:", error);
        status.textContent = error.message;
      }
    }


    </script>
  </body>
</html>
