async function getShipments() {

    const shipsDiv = document.getElementById("shipments");

try {
      const response = await fetch(`/shipment`);
      const result = await response.json();

     console.log("SHIPMENT GET RESULT: ", result);

      if (!response.ok) {
        throw new Error(result.error || `Request failed: ${response.status}`);
      }

      shipsDiv.replaceChildren();
      if (result.length === 0) {
        shipsDiv.textContent = "No shipment found.";
        return;
      }

      const list = document.createElement("ul");
      result.forEach((shipment) => {
        const listItem = document.createElement("li");
        listItem.append(
          document.createTextNode(
            `Shipment ID: ${shipment.id}, Receipt_ID: ${shipment.receipt_id}, User_ID: ${shipment.user_id}, \n Status: ${shipment.status},
            Shipment Location: "${shipment.location},Shipment target location: ${shipment.target_location}, start date: ${shipment.start_date} "
            `
          )
        );

        const listDeleteButton = document.createElement("button");
        listDeleteButton.type = "button";
        listDeleteButton.textContent = "CANCEL";
        listDeleteButton.addEventListener("click", () => cancelShipment(shipment.id));
        listItem.appendChild(listDeleteButton);

        const updateForm = document.createElement("form");
        updateForm.hidden = true;
        const fields = [
         // ["status", "Status", shipment.status],
          ["location", "Location", shipment.location],
          ["target_location", "Target location", shipment.target_location]
        ];
        fields.forEach(([name, labelText, value]) => {
          const label = document.createElement("label");
          label.textContent = `${labelText}: `;
          const input = document.createElement("input");
          input.type = "text";
          input.name = name;
          input.value = value ?? "";
          input.required = true;
          label.appendChild(input);
          updateForm.appendChild(label);
        });

        const submitButton = document.createElement("button");
        submitButton.type = "submit";
        submitButton.textContent = "Save";
        updateForm.appendChild(submitButton);

        const updateMessage = document.createElement("span");
        updateMessage.setAttribute("role", "status");
        updateForm.appendChild(updateMessage);
        updateForm.addEventListener("submit", (event) => {
          event.preventDefault();
          submitShipmentUpdate(shipment.id, updateForm);
        });

        const listUpdateButton = document.createElement("button");
        listUpdateButton.type = "button";
        listUpdateButton.textContent = "UPDATE";
        listUpdateButton.addEventListener("click", () => updateShipment(updateForm));

////////////////////////////


        const listRescheduleButton = document.createElement("button");
        listRescheduleButton.type = "button";
        listRescheduleButton.textContent = "RESCHEDULE";
        listRescheduleButton.addEventListener("click", () => restartShipment(shipment.id));
       // listRescheduleButton.appendChild(listDeleteButton);


        listItem.appendChild(listUpdateButton);
        listItem.appendChild(listDeleteButton);
        listItem.appendChild(listRescheduleButton);

        listItem.appendChild(updateForm);


     list.appendChild(listItem);


      });
      shipsDiv.appendChild(list);
    } catch (error) {
      console.error("Error loading receipts:", error);
      shipsDiv.textContent = error.message;
    }
};



async function deleteNotification(notificationId) {
  const status = document.getElementById("notification_status");
  const timer = notificationTimers.get(notificationId);
  if (timer) {
    clearTimeout(timer);
    notificationTimers.delete(notificationId);
  }

  try {
    const response = await fetch(`/notification/${notificationId}`, { method: "DELETE" });
    const result = await response.json();
    if (!response.ok) {
      throw new Error(result.error || `Request failed: ${response.status}`);
    }
    await getNotifications();
  } catch (error) {
    console.error("Error deleting notification:", error);
    status.textContent = error.message;
  }
}


function parseIgnoredTypes(value) {
  if (typeof value !== "string") {
    return new Map();
  }

  const ignoredTypes = new Map();
  for (const entry of value.split(",")) {
    const separator = entry.lastIndexOf(":");
    if (separator === -1) {
      continue;
    }

    const type = entry.slice(0, separator).trim().toLowerCase();
    if (type) {
      ///ADD TO MAP
      ignoredTypes.set(
        type,
        entry.slice(separator + 1).trim().toLowerCase() === "true",
      );
    }
  }
  return ignoredTypes;
}

