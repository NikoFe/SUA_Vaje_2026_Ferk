  async function getCartItems() {
    const cart = document.getElementById("cart");
    const status = document.getElementById("update_status");

    try {
      const response = await fetch("/user/cart");
      const result = await response.json();
      if (!response.ok) {
        throw new Error(result.error || `Request failed: ${response.status}`);
      }
     console.log("resultresultresultresultresultresult: ", result);
      cart.replaceChildren();
      if (result.length === 0) {
        cart.textContent = "Your cart is empty.";
        document.getElementById("cart_total").textContent = "Total: 0.00";
        return;
      }

      const items = document.createElement("ul");
      result.forEach((item) => {
        const listItem = document.createElement("li");
        listItem.textContent = `${item.product_name} — Quantity: ${item.amount}`;


        const remove_button = document.createElement("button");
        remove_button.textContent = "Remove";
        remove_button.addEventListener("click", async () => {
          try {
            const response = await fetch(`/user/cart/single/${encodeURIComponent(item.id)}`, {
              method: "DELETE",
            });
            const result = await response.json();
            if (!response.ok) {
              throw new Error(result.error || "Failed to remove item");
            }
            await getCartItems();
          } catch (error) {
            console.error("Error removing item:", error);
            status.textContent = error.message;
          }
        });

        items.appendChild(listItem);
        items.appendChild(remove_button);
      });
      cart.appendChild(items);

      const total = await calculateCartTotal(result);
      document.getElementById("cart_total").textContent = `Total: ${total.toFixed(2)}`;

    } catch (error) {
      console.error("Error loading cart:", error);
      status.textContent = error.message;
    }
  }

  async function calculateCartTotal(cartItems) {
    const response = await fetch("/store/products");
    const products = await response.json();
    if (!response.ok) {
      throw new Error(products.error || "Failed to load product prices");
    }


    //WIP change
    return cartItems.reduce((total, item) => {
      const product = products.find(
        (candidate) => String(candidate.id) === String(item.product_id)
      );
      if (!product) {
        throw new Error(`Product not found for cart item: ${item.product_name}`);
      }

      const cost = Number(product.cost);
      const amount = Number(item.amount);
      if (!Number.isFinite(cost) || !Number.isFinite(amount)) {
        throw new Error(`Invalid price or quantity for ${item.product_name}`);
      }

      return total + cost * amount;
    }, 0);
  }



